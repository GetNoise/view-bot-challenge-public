{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && git config core.hooksPath .githooks" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/archive-chat-logs.sh --commit" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/archive-chat-logs.sh --commit" } ] }
    ]
  }
}
